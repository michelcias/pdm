      mu_2_true, mu_2_true,
      phi_1_true, phi_1_true,
      phi_2_true, phi_2_true
    ),
    Estimate = c(
      median(out_logit$mu_1), median(out_probit$mu_1),
      median(out_logit$mu_2), median(out_probit$mu_2),
