    Parameter = c(
      "mu_1   (Logit)", "mu_1  (Probit)",
      "mu_2   (Logit)", "mu_2  (Probit)",
      "phi_1  (Logit)", "phi_1 (Probit)",
      "phi_2  (Logit)", "phi_2 (Probit)"
    ),
    True_Value = c(
