  prior_prec_y_shape = 1e-1,
  prior_prec_y_rate  = 1e-1,
  verbose            = FALSE,
  seed               = 456
)

if (requireNamespace("loo", quietly = TRUE)) {
  ## Single-model criteria
  loo::waic(out_level)
  loo::loo(out_level)

  ## Rank the two models (PSIS-LOO by default; best model on top)
