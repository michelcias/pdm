  # Scalar dynamic state parameters (for MCMC diagnostics)
  theta_01    = theta01_true,
  theta_02    = theta02_true,
  theta_03    = theta03_true,
  prec_theta1 = prec_theta1_true,
  prec_theta2 = prec_theta2_true,
